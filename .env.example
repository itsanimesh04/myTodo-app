# Accountability App Environment Variables

# Auth.js secret - generate with: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"

# MongoDB Database URL (Atlas or Local)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/accountability_app?retryWrites=true&w=majority"

# App URL (http://localhost:3000 locally, or https://<your-project>.vercel.app on Vercel)
NEXTAUTH_URL="http://localhost:3000"
